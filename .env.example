# Knot API Credentials
# Provision autonomously with 'npx @knot-ai/cli app create --name "My Search Demo" --write-env'
# Or from Knot Developer Console (https://connectknot.com/developers)

# Knot Server API Secret (knot_prod_* or knot_sandbox_*)
KNOT_SECRET="knot_sandbox_your_secret_key"

# Knot Public Client ID for frontend <ContinueWithKnot />
NEXT_PUBLIC_KNOT_CLIENT_ID="client_your_product_id"

# Base API Origin (Defaults to Production if omitted)
# For Staging: https://staging.connectknot.com/api
# For Production: https://production.connectknot.com/api
KNOT_BASE_URL="https://production.connectknot.com/api"
NEXT_PUBLIC_KNOT_BASE_URL="https://production.connectknot.com"
